# Local / plantilla genérica
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=itformdb
DB_USER=itform_usr
DB_PASS=change_me_strong_password
DB_CHARSET=utf8mb4

# Lab SQLite:
# DB_DRIVER=sqlite
# DB_PATH=/var/www/html/storage/db/itform.sqlite

SESSION_NAME=ITFORMSESSID
SESSION_IDLE_MINUTES=60
FORCE_SECURE_COOKIE=0
TRUST_PROXIES=0

ITFORM_AUTO_MIGRATE=1
ALLOW_PUBLIC_SAVE=0
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
API_RATE_MAX=30
API_RATE_WINDOW=60
