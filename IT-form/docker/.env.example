# Copiar a IT-form/.env
# cp docker/.env.example .env

# --- Base de datos ---
# BYOD MySQL del homelab:
# DB_DRIVER=mysql
# DB_HOST=mysql          # nombre del servicio en la red Docker
# DB_NAME=itformdb
# DB_USER=itform_usr
# DB_PASS=...
#
# Lab simple sin MySQL:
DB_DRIVER=sqlite
DB_PATH=/var/www/html/storage/db/itform.sqlite

DB_HOST=db
DB_PORT=3306
DB_NAME=itformdb
DB_USER=itform_usr
DB_PASS=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# Migraciones al arrancar el contenedor app
ITFORM_AUTO_MIGRATE=1
ITFORM_MIGRATE_RETRIES=30

APP_PORT=8088
ALLOW_PUBLIC_SAVE=0
SESSION_NAME=ITFORMSESSID
SESSION_IDLE_MINUTES=60
FORCE_SECURE_COOKIE=0

# Proxies (nginx-proxy, Traefik, Cloudflare Tunnel)
TRUST_PROXIES=1
VIRTUAL_HOST=
VIRTUAL_PORT=8080
LETSENCRYPT_HOST=
LETSENCRYPT_EMAIL=
HTTPS_METHOD=noredirect
TRAEFIK_ENABLE=false
# PROXY_NETWORK=kd-prod_net

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
API_RATE_MAX=30
API_RATE_WINDOW=60

# Imagen preconstruida (GHCR) opcional
# ITFORM_WEB_IMAGE=ghcr.io/lfloresbatista/it-form:v1.0.1
