# Copiar a IT-form/.env antes de docker compose
# cp docker/.env.example .env

DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=itformdb
DB_USER=itform_usr
DB_PASS=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password

APP_PORT=8088
ALLOW_PUBLIC_SAVE=0
SESSION_NAME=ITFORMSESSID
SESSION_IDLE_MINUTES=60
FORCE_SECURE_COOKIE=0
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
API_RATE_MAX=30
API_RATE_WINDOW=60
