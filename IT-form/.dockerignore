# Context de build = raíz IT-form/
.git
.gitignore
.env
.env.*
!.env.example

# Tooling Docker (compose/Dockerfile) fuera de la imagen,
# EXCEPTO el entrypoint que la imagen sí necesita.
docker/**
!docker/docker-entrypoint.sh

# Runtime
storage/db/*
!storage/db/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

pdfs-test/
**/*.sqlite
**/*.log
.vscode/
.idea/
*.swp
.DS_Store
*.zip

# Vendor pesado opcional de ejemplos TCPDF
tcpdf/examples/
tcpdf/tools/
tcpdf/fonts/dejavu-fonts-ttf-*
tcpdf/fonts/freefont-*
