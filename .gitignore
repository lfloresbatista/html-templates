# Secrets & local env
.env
.env.local
IT-form/secret
IT-form/storage/db/*.sqlite
IT-form/storage/db/*.sqlite-*
IT-form/storage/logs/*
!IT-form/storage/logs/.gitkeep
IT-form/.login_attempts

# Dependencies / bloat
vendor/
*.zip
IT-form/tcpdf/main.zip
IT-form/master.zip

# Logs and temp
*.log
*.tmp
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# PDFs de prueba locales (descargables para validación manual; no versionar)
IT-form/pdfs-test/

# Uploads de logos de clientes (runtime)
IT-form/uploads/*
!IT-form/uploads/.htaccess
!IT-form/uploads/.gitkeep

# Note: dist/ IS tracked (runtime assets without npm build)

# Firmados runtime
IT-form/storage/firmados/*
!IT-form/storage/firmados/.gitkeep
!IT-form/storage/firmados/.htaccess
